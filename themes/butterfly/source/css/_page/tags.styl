.tag-cloud
  &-list
    a
      display: inline-block
      padding: 0 8px
      transition: all .3s

      &:hover
        color: $text-hover !important
        transform: scale(1.1)

      +maxWidth768()
        zoom: .85

  &-title
    font-size: 2.57em

    +maxWidth768()
      font-size: 2em

h1.page-title
  & + .tag-cloud-list
    text-align: left

// canvas 滚动标签云（在原有文本云之后）
#tags-canvas-cloud
  margin-top: 4rem
  text-align: center

  .tags-canvas-title
    margin-bottom: 1.5rem
    font-size: 1.6em
    font-weight: bold
    color: var(--text-highlight-color, #49b1f5)

  #resCanvas
    display: block
    margin: 0 auto
    max-width: 100%
    height: auto

  +maxWidth768()
    margin-top: 2.5rem

    #resCanvas
      width: 100%
      height: 320px
